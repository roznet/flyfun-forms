<?xml version="1.0" encoding="utf-8"?>
<!--
  Same art as the iOS AppIcon (FlightFormsLight-1024.png). The PNG is flattened
  and full-bleed, so the foreground fills the 72dp visible viewport (the middle
  two thirds of the 108dp canvas) and the background is the art's edge colour,
  which only shows during launcher parallax.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
