<resources>
    <!--
      Only the window behind the first frame: Compose draws everything else
      with FlyFunTheme. DayNight so a dark-mode launch does not flash white.
    -->
    <style name="Theme.FlyFunForms" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
