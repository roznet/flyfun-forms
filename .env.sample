# Plain configuration. Secrets (DB URL with its password, JWT secret, OAuth client
# secrets, private keys) go in .env.secrets next to it: see .env.secrets.sample.
# docker compose passes both files to the container; scripts/asc.py and play.py load
# .env then .env.secrets. Each key belongs in exactly one of the two.

# Required in production
ENVIRONMENT=production
# DATABASE_URL: in .env.secrets
# JWT_SECRET: in .env.secrets

# OAuth (shared with flyfun-weather — same credentials)
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET: in .env.secrets

# Apple Sign In – native iOS token validation
APPLE_APP_IDS=net.ro-z.flyfun-forms

# Optional: Apple web OAuth (only if using browser-based flow)
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY: in .env.secrets

# Optional: airports.db for name resolution
# AIRPORTS_DB=/app/data/airports.db

# Developer machine only (never the server): App Store Connect API key used by
# scripts/asc.py and the /archive skill. Same team key as flyfun-weather, App
# Manager role. The .p8 stays outside the repo — this path is Apple's default.
ASC_KEY_ID=
ASC_ISSUER_ID=
#ASC_KEY_P8_PATH=~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
# Optional: skip the bundle-id lookup
#ASC_APP_ID=

# Developer machine only: Google Play Developer API service account used by
# scripts/play.py. The JSON key stays outside the repo — this is the default.
#PLAY_SERVICE_ACCOUNT_JSON=~/.googleplaystore/private_keys/play-service-account.json
#PLAY_PACKAGE_NAME=aero.flyfun.forms
