.DS_Store

tmp/
previews/
# Anchored: unanchored `data/` also matched the Kotlin `data` package in
# the Android app and silently dropped those files from commits.
/data/
src/flightforms/data/
venv/
*.db
!app/flyfun-forms/flyfun-forms/airports.db
__pycache__/
*.pyc
*.egg-info/
.env
# App Store Connect keys live in ~/.appstoreconnect/private_keys/; this guards
# against an accidental `git add` of a downloaded AuthKey_*.p8.
*.p8
dist/
build/

# Xcode user data
*.xcuserstate
xcuserdata/

# Claude: settings.json is shared (tracked so worktrees inherit it);
# settings.local.json is per-machine.
.claude/settings.local.json
.claude/worktrees
.claude/projects

# Android
.gradle/
local.properties
.idea/
*.iml
.cxx/
