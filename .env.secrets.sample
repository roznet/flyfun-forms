# FlyFun Forms secrets: copy to .env.secrets (gitignored, keep it mode 600) and fill in.
# Plain configuration is in .env (see .env.sample). docker compose passes both files to
# the container. In the owner's setup this file is sops-encrypted in the config repo and
# decrypted by syncfiles on the host that uses it: don't hand-edit it there.

# Required in production
DATABASE_URL=mysql+pymysql://user:pass@shared-mysql:3306/flyfun
JWT_SECRET=change-me-in-production

# OAuth (shared with flyfun-weather: same credentials; GOOGLE_CLIENT_ID is in .env)
GOOGLE_CLIENT_SECRET=

# Optional: Apple web OAuth private key (only if using the browser-based flow)
# APPLE_PRIVATE_KEY=
